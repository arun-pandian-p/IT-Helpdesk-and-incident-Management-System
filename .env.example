# ===========================================================================
# IT HELPDESK & END-USER SUPPORT SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================================================

# Database URL
# For local SQLite dev: sqlite:///./helpdesk.db
# For PostgreSQL / Docker: postgresql://postgres:postgrespassword@localhost:5432/helpdesk
DATABASE_URL=sqlite:///./helpdesk.db

# JWT Security
JWT_SECRET=super-production-jwt-secret-replace-in-env-9823412
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Frontend API Target (for Vercel / Production)
# VITE_API_URL=https://your-backend-render-app.onrender.com
