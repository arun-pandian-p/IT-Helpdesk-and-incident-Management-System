# ===========================================================================
# IT HELPDESK & SERVICE DESK SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================================================

# Server Port
PORT=8000

# SQLite Database Location
# Spring Boot connects via jdbc:sqlite:${DB_PATH:helpdesk.db}
DB_PATH=helpdesk.db

# JWT Security Configuration
JWT_SECRET=super-production-jwt-secret-replace-in-env-9823412
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://localhost:80

# Frontend API Target (Vite development proxy or custom deployment URL)
# VITE_API_URL=http://localhost:8000
